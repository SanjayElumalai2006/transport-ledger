# Transport Ledger - Environment Configuration
# Copy this file to .env and customize with your credentials

# Port for local Node.js server (Default: 8080)
PORT=8080

# MongoDB Connection String (MongoDB Atlas or Local MongoDB)
# Example MongoDB Atlas URI:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/transport_ledger?retryWrites=true&w=majority
#
# Example Local MongoDB URI:
# MONGODB_URI=mongodb://localhost:27017/transport_ledger
#
# If MONGODB_URI is left blank or not set, the application will automatically
# use the local atomic JSON file database (data/database.json) with zero configuration.
MONGODB_URI=

# Optional Database Name (Defaults to "transport_ledger")
MONGODB_DB_NAME=transport_ledger
